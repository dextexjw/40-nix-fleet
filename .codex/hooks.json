{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/fleet-command-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking fleet lifecycle safety"
          }
        ]
      }
    ]
  }
}
